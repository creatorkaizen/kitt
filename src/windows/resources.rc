// Kitt native layout DLL resources.
//
// Minimal Windows resource script: version info + product metadata
// only. Kitt's native layer must stay "boring" (KITT_ARCHITECTURE.md
// section 8) so nothing beyond standard VERSIONINFO is included
// here (no dialogs, icons, custom UI).

#include <winresrc.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     0,1,0,0
 PRODUCTVERSION  0,1,0,0
 FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_DLL
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Kitt Project"
            VALUE "FileDescription",  "Kitt Ukrainian Mnemonic Keyboard Layout"
            VALUE "FileVersion",      "0.1.0.0"
            VALUE "InternalName",     "kittua"
            VALUE "LegalCopyright",   "Kitt Project"
            VALUE "OriginalFilename", "kittua.dll"
            VALUE "ProductName",      "Kitt"
            VALUE "ProductVersion",   "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
